			if y and m and d then
				dateFormatted = string.format(" [%s.%s.%s]", d, m, y)
			end
		end
		local fullInfo = string.format("#%d: %s — %s%s", i, b.name or "Бейдж", gameName, dateFormatted)
		badgeBtn.MouseEnter:Connect(function()
			if reqId == currentRequestId then
				badgesHeaderLabel.Text = fullInfo
				badgesHeaderLabel.TextColor3 = Color3.fromRGB(255, 220, 110)
			end
