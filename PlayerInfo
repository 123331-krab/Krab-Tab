		return
	end
	badgesHeaderLabel.Text = "Последние " .. tostring(#badgesList) .. " бейджей (наведи для игры и даты):"
	for i, b in ipairs(badgesList) do
		local badgeBtn = Instance.new("ImageButton")
		badgeBtn.Size = UDim2.new(0, 44, 0, 44)
		badgeBtn.BackgroundColor3 = Color3.fromRGB(24, 24, 30)
		badgeBtn.BorderSizePixel = 0
		badgeBtn.LayoutOrder = i
		badgeBtn.Image = "rbxthumb://type=BadgeIcon&id=" .. tostring(b.id) .. "&w=150&h=150"
		badgeBtn.Parent = badgesStrip
		local bc = Instance.new("UICorner")
		bc.CornerRadius = UDim.new(1, 0)
		bc.Parent = badgeBtn
		local gameName = (b.awarder and b.awarder.name) or "Игра"
		local rawDate = awardedMap[b.id]
		local dateFormatted = ""
		if rawDate then
