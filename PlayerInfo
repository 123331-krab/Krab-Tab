local function switchTab(tabName)
	if activeTab == tabName then
		activeTab = nil
		listContainer.Visible = false
		updateLayoutPositions()
		return
	end
	activeTab = tabName
	listContainer.Visible = true
	updateLayoutPositions()
	clearScroll()
	local reqId = currentRequestId
	if tabName == "Friends" then
		if #cachedFriends == 0 then
			addEmptyMessage("Друзей нет или список скрыт")
			return
		end
		for i, f in ipairs(cachedFriends) do
			addListRow(i, f.displayName or f.name, "@" .. f.name .. " — нажми для перехода", f.id, "Avatar", reqId, function()
				inspectByUserId(f.id, f.name, f.displayName or f.name)
			end, nil)
		end
	elseif tabName == "Places" then
		if #cachedPlaces == 0 then
			addEmptyMessage("Рабочих открытых плейсов не найдено")
			return
		end
		for i, p in ipairs(cachedPlaces) do
			local visits = formatNumber(p.placeVisits or 0)
			addListRow(i, p.name or "Без названия", "Визитов: " .. visits .. " | PlaceID: " .. tostring(p.rootPlaceId or p.id), p.id, "Game", reqId, function()
				if copyClipboard then copyClipboard(tostring(p.rootPlaceId or p.id)) end
			end, nil)
		end
	elseif tabName == "Items" then
		if #cachedItems == 0 then
			addEmptyMessage("Созданных предметов/косметики не найдено")
			return
		end
		for i, item in ipairs(cachedItems) do
			local priceStr = (item.price and item.price > 0) and (formatNumber(item.price) .. " R$") or "Бесплатно / Не в продаже"
			addListRow(i, item.name or "Предмет", priceStr .. " | ID: " .. tostring(item.id), item.id, "Asset", reqId, function()
				if copyClipboard then copyClipboard(tostring(item.id)) end
			end, nil)
		end
	elseif tabName == "WornExp" then
		if #cachedWornExp == 0 then
			addEmptyMessage("Надетых вещей от 2,000 R$ или лимиток нет")
			return
		end
		for i, w in ipairs(cachedWornExp) do
			local tagText = w.tag ~= "" and ("[" .. w.tag .. "] ") or ""
			local priceText = w.price > 0 and (formatNumber(w.price) .. " R$") or "Лимитка (нет в продаже)"
			addListRow(i, tagText .. w.name, "Цена: " .. priceText .. " | ID: " .. tostring(w.id), w.id, "Asset", reqId, function()
				if copyClipboard then copyClipboard(tostring(w.id)) end
			end, nil)
		end
	elseif tabName == "FavGames" then
		if #cachedFavGames == 0 then
			addEmptyMessage("Избранные игры скрыты или отсутствуют")
			return
		end
		for i, g in ipairs(cachedFavGames) do
			local visits = formatNumber(g.placeVisits or 0)
			local creator = (g.creator and g.creator.name) or "Автор неизвестен"
			addListRow(i, g.name or "Игра", "Автор: " .. creator .. " | Визитов: " .. visits, g.id, "Game", reqId, function()
				if copyClipboard then copyClipboard(tostring(g.rootPlaceId or g.id)) end
			end, nil)
		end
	elseif tabName == "FavAudio" then
		if #cachedFavAudio == 0 then
			addEmptyMessage("Избранная музыка скрыта или отсутствует")
			return
		end
		for i, a in ipairs(cachedFavAudio) do
			local creator = (a.creator and a.creator.name) or "Неизвестен"
