    end
end)

local function unloadScript()
    pcall(function() isRunning = false end)
    pcall(function() isDestroyed = true end)
    pcall(function() restoreOriginalColors() end)
    
    local pg = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        for _, name in ipairs({"SkinModeGui", "ColorTransitionGui"}) do
            local gui = pg:FindFirstChild(name)
            if gui then gui:Destroy() end
        end
    end
end

