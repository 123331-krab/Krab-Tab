    waitDelay = math.max(0.03, math.floor((waitDelay - 0.02) * 100 + 0.5) / 100)
    delayLabel.Text = string.format("Ждать: %.2fс", waitDelay)
end)
delayUpBtn.MouseButton1Click:Connect(function()
