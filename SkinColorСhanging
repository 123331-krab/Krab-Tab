local function saveOriginalColors()
    if savedColors then return end
    local char = player.Character
    if not char then return end
    local bc = char:FindFirstChildOfClass("BodyColors")
    if bc then
        savedColors = {
            HeadColor = bc.HeadColor3, TorsoColor = bc.TorsoColor3,
            LeftArmColor = bc.LeftArmColor3, RightArmColor = bc.RightArmColor3,
            LeftLegColor = bc.LeftLegColor3, RightLegColor = bc.RightLegColor3
        }
    end
end
local function findCatalogRemote()
    local remote = ReplicatedStorage:FindFirstChild("CatalogGuiRemote", true)
    if remote and remote:IsA("RemoteFunction") then return remote end
    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteFunction") and (obj.Name:lower():find("catalog") or obj.Name:lower():find("desc")) then
            return obj
        end
    end
    return nil
end
local function applyColors(colorTable)
    local remote = findCatalogRemote()
    if not remote then return false end
    pcall(function()
        remote:InvokeServer({["Action"] = "UpdateHumanDescProperties", ["Properties"] = colorTable})
    end)
    return true
end
local function restoreOriginalColors()
    if savedColors then
        applyColors(savedColors)
        savedColors = nil
    end
end
local function getModeColor(t)
    local rawWave = 1 - math.abs((t % 2) - 1)
    local wave = isSuperSmooth and (rawWave * rawWave * (3 - 2 * rawWave)) or rawWave
    local mode = modes[currentModeIdx]
    if mode == "Радуга" then
        return Color3.fromHSV((t * 0.5) % 1, 1, 1)
    elseif mode == "Монохром" then
        return Color3.new(wave, wave, wave)
    elseif mode == "Тон кожи" then
        local lightSkin = Color3.fromRGB(255, 224, 196)
        local darkSkin = Color3.fromRGB(55, 32, 20)
        return lightSkin:Lerp(darkSkin, wave)
    elseif mode == "Золото" then
        local deepAmber = Color3.fromRGB(130, 80, 10)
        local brightGold = Color3.fromRGB(255, 225, 90)
        return deepAmber:Lerp(brightGold, wave)
    elseif mode == "Галактика" then
        local c1 = Color3.fromRGB(18, 10, 45)
        local c2 = Color3.fromRGB(135, 35, 225)
        local c3 = Color3.fromRGB(45, 200, 255)
        if wave < 0.5 then
            return c1:Lerp(c2, wave * 2)
        else
            return c2:Lerp(c3, (wave - 0.5) * 2)
        end
    elseif mode == "Огонь" then
        local f1 = Color3.fromRGB(95, 15, 0)
        local f2 = Color3.fromRGB(240, 55, 0)
        local f3 = Color3.fromRGB(255, 145, 0)
        local f4 = Color3.fromRGB(255, 235, 110)
        if wave < 0.33 then
            return f1:Lerp(f2, wave / 0.33)
        elseif wave < 0.66 then
            return f2:Lerp(f3, (wave - 0.33) / 0.33)
        else
            return f3:Lerp(f4, (wave - 0.66) / 0.34)
        end
    end
end
local function startTransition()
    task.spawn(function()
        if not findCatalogRemote() then
            isRunning = false
            startBtn.Text = "No Remote"
            startBtn.BackgroundColor3 = Color3.fromRGB(160, 140, 20)
            return
        end
        while isRunning and not isDestroyed do
            local c = getModeColor(step)
            applyColors({
                HeadColor = c, TorsoColor = c, LeftArmColor = c,
                RightArmColor = c, LeftLegColor = c, RightLegColor = c
            })
            local currentStepSize = isSuperSmooth and 0.012 or 0.04
            step = step + currentStepSize
            task.wait(waitDelay)
        end
    end)
end
