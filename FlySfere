_G.CosmicChaos.InputConn = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if input.KeyCode == cfg.ACTIVATE_KEY then
        if v.active then 
            cc.CleanUp(true)
        else
            local foundTarget = false
            local targetMesh = mouse.Target
            if targetMesh and targetMesh.Parent then
                local model = targetMesh.Parent
                if model:IsA("Accessory") then model = model.Parent end
                local clickedPlayer = Players:GetPlayerFromCharacter(model)
                if clickedPlayer and clickedPlayer ~= player then
                    cc.SwitchToTarget(model); foundTarget = true
                end
            end
            if not foundTarget then
                local closest = GetClosestTarget()
                if closest then cc.SwitchToTarget(closest) end
            end
        end
    end

    if input.KeyCode == Enum.KeyCode.Right and v.active then
        v.autoCarousel = false 
        local nextTarget = CycleTarget(1)
        if nextTarget then cc.SwitchToTarget(nextTarget) end
    end

    if input.KeyCode == Enum.KeyCode.Left and v.active then
        v.autoCarousel = false 
        local prevTarget = CycleTarget(-1)
        if prevTarget then cc.SwitchToTarget(prevTarget) end
    end

    if input.KeyCode == cfg.FAST_SWITCH_KEY and v.active then
        v.autoCarousel = not v.autoCarousel
        if v.autoCarousel then
            v.lastCarouselSwitch = tick()
            local targets = cc.GetSortedTargets()
            local newTarget = #targets > 0 and targets[math.random(1, #targets)] or nil
            if newTarget then cc.SwitchToTarget(newTarget) end
        end
    end
end)

