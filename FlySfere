_G.CosmicChaos.Settings = {
    ACTIVATE_KEY = Enum.KeyCode.N, 
    FAST_SWITCH_KEY = Enum.KeyCode.M,
    BOOST_KEY = Enum.KeyCode.B,   
    SLOW_KEY = Enum.KeyCode.V,    
    DISTANCE_MIN = 10,
    DISTANCE_MAX = 50,
    START_SPEED = 1.0,
    MAX_SPEED = 1260,
    ACCELERATION_TIME = 420,
    PULL_SPEED = 0.15
}
