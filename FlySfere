local mouse = player:GetMouse()

local cc = _G.CosmicChaos
if not cc then print("Error: Please run Part 1 first!") return end
local v = cc.Vars
local cfg = cc.Settings

local function GetClosestTarget()
    local targets = cc.GetSortedTargets()
    local closestChar = nil
    local minDistance = math.huge
    local myRoot = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    for _, char in ipairs(targets) do
        local tRoot = char:FindFirstChild("HumanoidRootPart")
        if tRoot then
            local dist = (myRoot.Position - tRoot.Position).Magnitude
            if dist < minDistance then minDistance = dist; closestChar = char end
        end
    end
    return closestChar
end

local function CycleTarget(direction)
    local targets = cc.GetSortedTargets()
    if #targets == 0 then return nil end
    if #targets == 1 then return targets end
    
    local currentIndex = 1
    if v.targetChar then
        local targetPlayer = Players:GetPlayerFromCharacter(v.targetChar)
        if targetPlayer then
            for i, char in ipairs(targets) do
                local p = Players:GetPlayerFromCharacter(char)
                if p and p.UserId == targetPlayer.UserId then currentIndex = i break end
            end
        end
    end
    
    local nextIndex = currentIndex + direction
    if nextIndex > #targets then nextIndex = 1 end
    if nextIndex < 1 then nextIndex = #targets end
    
    return targets[nextIndex]
end

-- Перезапускаем инпут-коннект, чтобы старые не плодились в памяти Xeno
if _G.CosmicChaos.InputConn then 
