local DESTROY_KEY = Enum.KeyCode.RightControl
local TOGGLE_KEY = Enum.KeyCode.J
local MODIFIER_KEY = Enum.KeyCode.LeftControl

local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")

local player = Players.LocalPlayer
local mouse = player:GetMouse()

_G.LightningModeActive = false
local isTeleporting = false 

local inputBeganConnection = nil
local destroyConnection = nil

local function destroyScript()
	if inputBeganConnection then inputBeganConnection:Disconnect() end
	if destroyConnection then destroyConnection:Disconnect() end
	_G.XenoLightningTeleportConnection = nil
	_G.XenoScriptDestroyConnection = nil
	_G.LightningModeActive = nil
	print("[Xeno] Скрипт полностью удален!")
end

local function getRandomOffset(currentRadius)
	local randomX = (math.random() * (currentRadius - 0.1) + 0.1)
	local randomZ = (math.random() * (currentRadius - 0.1) + 0.1)
	local randomY = (math.random() * (1 - 0.1) + 0.1)
	
	if math.random(1, 2) == 1 then randomX = -randomX end
	if math.random(1, 2) == 1 then randomZ = -randomZ end
	
	return Vector3.new(randomX, randomY, randomZ)
end

if _G.XenoLightningTeleportConnection then _G.XenoLightningTeleportConnection:Disconnect() end
if _G.XenoScriptDestroyConnection then _G.XenoScriptDestroyConnection:Disconnect() end

inputBeganConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end 
	
	if input.KeyCode == TOGGLE_KEY then
		_G.LightningModeActive = not _G.LightningModeActive
		if _G.LightningModeActive then
			print("[Xeno] Режим Грозы (Рывок 0.025с): ВКЛЮЧЕН. Удерживайте LeftCtrl + ЛКМ.")
		else
			print("[Xeno] Режим Грозы: ВЫКЛЮЧЕН.")
		end
		return
	end
	
	if input.UserInputType == Enum.UserInputType.MouseButton1 and _G.LightningModeActive and not isTeleporting then
		if UserInputService:IsKeyDown(MODIFIER_KEY) then
			if not mouse.Target then 
				return 
			end
			
			local character = player.Character
			local rootPart = character and character:FindFirstChild("HumanoidRootPart")
			
			if not rootPart then return end
			isTeleporting = true
			
			local finalTarget = mouse.Hit.Position + Vector3.new(0, 3, 0)
			
			pcall(function()
				local attachment = Instance.new("Attachment")
				attachment.Name = "LightningAttachment"
				attachment.Parent = rootPart
				
				local startCFrame = rootPart.CFrame
				
				---------------------------------------------------------
				-- ФАЗА 1: Акселерация на месте (1.5 секунды)
				---------------------------------------------------------
				local startDuration = 1.5
				local startTime = os.clock()
				
				while os.clock() - startTime < startDuration do
					if not inputBeganConnection.Connected or not rootPart or not rootPart.Parent then 
						if attachment then attachment:Destroy() end
						return 
					end
					local elapsed = (os.clock() - startTime) / startDuration
					if elapsed > 1 then elapsed = 1 end
					local currentRadius = 0.1 + (3 - 0.1) * elapsed
					local offset = getRandomOffset(currentRadius)
					rootPart.CFrame = startCFrame * CFrame.new(offset)
					task.wait(0.04)
				end
				
				---------------------------------------------------------
				-- ФАЗА 2: Зигзаг-перемещение (Интервал 0.025 секунды)
				---------------------------------------------------------
				local startPos = rootPart.Position
				local totalVector = finalTarget - startPos
				local totalDistance = totalVector.Magnitude
				local direction = totalVector.Unit
				
				local stepDistance = 6
				local totalSteps = math.floor(totalDistance / stepDistance)
				if totalSteps < 1 then totalSteps = 1 end
				
				local sideVector = Vector3.new(-direction.Z, 0, direction.X).Unit
				local zigZagDirection = 1
				
				for step = 1, totalSteps do
					if not inputBeganConnection.Connected or not character or not character.Parent or not rootPart then 
						if attachment then attachment:Destroy() end
						return 
					end
					
					local linearNextPos = startPos + (direction * (step * stepDistance))
					
					local randomWidth = math.random() * (9 - 5) + 5
					local randomHeight = math.random() * (3 - 0) + 0
					
					local zigZagPos = linearNextPos + (sideVector * (randomWidth * zigZagDirection)) + Vector3.new(0, randomHeight, 0)
					zigZagDirection = -zigZagDirection
					
					character:MoveTo(zigZagPos)
					task.wait(0.025) -- Интервал изменен на 0.025 сек
				end
				
				character:MoveTo(finalTarget)
				task.wait(0.025)
				local newCenterCFrame = rootPart.CFrame
				
				---------------------------------------------------------
				-- ФАЗА 3: Затухание на новом месте (1 секунда)
				---------------------------------------------------------
				local endDuration = 1
				local endTime = os.clock()
				
				while os.clock() - endTime < endDuration do
					if not inputBeganConnection.Connected or not rootPart or not rootPart.Parent then 
						if attachment then attachment:Destroy() end
						return 
					end
					local elapsed = (os.clock() - endTime) / endDuration
					if elapsed > 1 then elapsed = 1 end
					local currentRadius = 3 - (3 - 0.1) * elapsed
					local offset = getRandomOffset(currentRadius)
					rootPart.CFrame = newCenterCFrame * CFrame.new(offset)
					task.wait(0.04)
				end
				
				if rootPart and rootPart.Parent and inputBeganConnection.Connected then
					rootPart.CFrame = newCenterCFrame
				end
				if attachment then attachment:Destroy() end
			end)
			
			isTeleporting = false
		end
	end
end)

_G.XenoLightningTeleportConnection = inputBeganConnection
_G.XenoScriptDestroyConnection = destroyConnection

print("[Xeno] Скрипт полностью обновлен! Задержка рывка: 0.025 сек. Нажмите J.")

_G.KrabHubScripts = _G.KrabHubScripts or {}
_G.KrabHubScripts["Teleport"] = destroyScript
