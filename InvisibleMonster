if game.CoreGui:FindFirstChild("YetiBeatingSystemGui") then
    game.CoreGui.YetiBeatingSystemGui:Destroy()
end

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")
local camera = workspace.CurrentCamera

local systemActive = false
local beatingBlock = nil
local loopConnection = nil
local inputConnection = nil
local deathConnection = nil
local weld = nil
local isDeadFake = false

-- Локальный звук (слышишь только ты)
local function playLocalSound(soundId)
    local localSound = Instance.new("Sound", rootPart)
    localSound.SoundId = "rbxassetid://" .. tostring(soundId)
    localSound.Volume = 3
    localSound:Play()
    Debris:AddItem(localSound, 3)
end

-- Функция принудительного ресета ровно через 10 секунд лежания
local function handleRespawnDelay()
    print("Режим скрытого 0.1 HP активен. Труп лежит на полу...")
    
    -- Даем телу полежать ровно 10 секунд
    task.wait(10)
    
    print("10 секунд прошло. Выполняется принудительный ресет персонажа...")
    pcall(function()
        workspace.Gravity = 196.2 -- Возвращаем стандартную гравитацию карты
        
        -- Снимаем якоря с частей тела перед смертью, чтобы не ломать анимацию спавна
        local head = character:FindFirstChild("Head")
        if head then head.Anchored = false end
        rootPart.Anchored = false
        
        -- Убиваем персонажа на сервере для полноценного чистого ресета
        humanoid.Health = 0.1 
    end)
end

-- Мягкая очистка при реальной смерти (например, если нажал Reset в меню ESC раньше времени)
local function selfDestruct()
    if not systemActive then return end
    systemActive = false
    
    if loopConnection then loopConnection:Disconnect() loopConnection = nil end
    if inputConnection then inputConnection:Disconnect() end
    if deathConnection then deathConnection:Disconnect() end
    
    if beatingBlock and not (beatingBlock:GetAttribute("IsBuried") == true) then
        pcall(function() beatingBlock:Destroy() end)
        beatingBlock = nil
    end
    
    task.spawn(handleRespawnDelay)
end

deathConnection = humanoid.Died:Connect(selfDestruct)

local function startYetiAttack()
    if systemActive then return end
    systemActive = true
    isDeadFake = false
    
    local torso = character:FindFirstChild("Torso") or character:FindFirstChild("UpperTorso")
    local leg = character:FindFirstChild("Right Leg") or character:FindFirstChild("RightFoot")
    local head = character:FindFirstChild("Head")
    
    if not torso or not leg or not head then 
        systemActive = false 
        return 
    end
    
    pcall(function() workspace.Gravity = 130 end)
    
    -- 1. Активация физического рэгдолла
    humanoid.PlatformStand = true
    humanoid:ChangeState(Enum.HumanoidStateType.Physics)
    
    -- 2. Импульс от груди назад
    local initialPush = -torso.CFrame.LookVector * 55 + Vector3.new(0, 14, 0)
    rootPart.AssemblyLinearVelocity = initialPush
    
    task.wait(0.4)
    if not systemActive or humanoid.Health <= 0 then return end
    
    local lookVector = torso.CFrame.LookVector
    local rightVector = torso.CFrame.RightVector
    
    beatingBlock = Instance.new("Part")
    beatingBlock.Size = Vector3.new(1.2, 1.2, 1.2)
    beatingBlock.Transparency = 1
    beatingBlock.CanCollide = false
    beatingBlock.Anchored = false 
    beatingBlock.Parent = workspace
    beatingBlock.CFrame = leg.CFrame
    
    weld = Instance.new("Weld")
    weld.Part0 = leg
    weld.Part1 = beatingBlock
    weld.C0 = CFrame.new(0, -1, 0)
    weld.Parent = beatingBlock
    
    local attachment = Instance.new("Attachment", beatingBlock)
    local linearVelocity = Instance.new("LinearVelocity", beatingBlock)
    linearVelocity.MaxForce = 999999
    linearVelocity.VelocityConstraintMode = Enum.VelocityConstraintMode.Vector
    linearVelocity.Attachment0 = attachment
    
    local angleTime = 0
    local hitCooldown = false
    local currentReach = math.random(86, 106) / 10 
    
    local isFinishing = false 
    local finishTimer = 0
    local fatalityChoice = nil
    local initialFinishPos = nil
    
    loopConnection = RunService.Heartbeat:Connect(function(dt)
        if not systemActive or isDeadFake then return end
        
        -- СРАБАТЫВАНИЕ ДОБИВАНИЯ (Здоровье <= 20 HP)
        if humanoid.Health <= 20 and not isFinishing then
            isFinishing = true
            
            if linearVelocity then linearVelocity:Destroy() end
            if weld then weld:Destroy() end
            
            rootPart.AssemblyLinearVelocity = Vector3.zero
            rootPart.AssemblyAngularVelocity = Vector3.zero
            
            initialFinishPos = rootPart.Position + Vector3.new(0, 3, 0)
            fatalityChoice = math.random(1, 2)
            
            playLocalSound(138090914) 
        end
        
        if isFinishing then
            finishTimer = finishTimer + dt
            
            -- ФАЗА ПЛАВНОГО ШАТАНИЯ ПЕРЕД СМЕРТЬЮ
            if finishTimer < 2.5 then
                angleTime = angleTime + dt * 3.0
                local shakeOffset = rightVector * math.sin(angleTime) * 1.0
                local targetHoldPos = initialFinishPos + shakeOffset
                rootPart.CFrame = rootPart.CFrame:Lerp(CFrame.new(targetHoldPos) * CFrame.Angles(math.rad(90), 0, 0), dt * 6)
                
                rootPart.AssemblyLinearVelocity = Vector3.zero
                rootPart.AssemblyAngularVelocity = Vector3.zero
            else
                -- МОМЕНТ ИСПОЛНЕНИЯ: Выставляем 0.1 HP и ломаем цикл
                isDeadFake = true
                humanoid.Health = 0.1 
                
                if fatalityChoice == 1 then
                    -- ВАРИАНТ 1: Выброс в сторону целым телом
                    local throwPower = math.random(35, 45)
                    local throwDir = (rightVector * (math.random(0, 1) == 0 and 1 or -1) * throwPower) + Vector3.new(0, 12, 0)
                    rootPart.AssemblyLinearVelocity = throwDir
                    
                    task.wait(0.4)
                    selfDestruct()
                    
                elseif fatalityChoice == 2 then
                    -- ВАРИАНТ 2: Вертикальное втыкание головой под землю
                    if loopConnection then loopConnection:Disconnect() loopConnection = nil end
                    
                    local raycastParams = RaycastParams.new()
                    raycastParams.FilterDescendantsInstances = {character}
                    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
                    local ray = workspace:Raycast(head.Position, Vector3.new(0, -25, 0), raycastParams)
                    local groundY = ray and ray.Position.Y or (rootPart.Position.Y - 3)
                    
                    head.Anchored = true
                    head.CFrame = CFrame.new(head.Position.X, groundY - 1.5, head.Position.Z) * CFrame.Angles(math.rad(-90), 0, 0)
                    rootPart.Anchored = true
                    
                    if beatingBlock then beatingBlock:SetAttribute("IsBuried", true) end
                    selfDestruct()
                end
            end
            return
        end
        
        -- ОБЫЧНЫЙ ЦИКЛ ОХОТЫ
        angleTime = angleTime + dt * 4.5
        local cosPhase = math.cos(angleTime)
        local sinPhase = math.sin(angleTime)
        local targetVelocityY = 0
        local targetVelocityZ = 0
        
        if cosPhase > 0.05 and cosPhase < 0.35 then
            targetVelocityY = -1.5
            targetVelocityZ = lookVector * 2
        elseif cosPhase >= 0.35 then
            targetVelocityY = -cosPhase * (currentReach * 3.2)
            targetVelocityZ = sinPhase * 38
        else
            targetVelocityY = -cosPhase * (currentReach * 2.53)
            targetVelocityZ = -sinPhase * 32
        end
        
        local noiseX = math.noise(angleTime * 0.4, 0, 0) * 3
        local noiseZ = math.noise(0, angleTime * 0.4, 0) * 3
        
        local finalVelocity = Vector3.new(
            lookVector.X * targetVelocityZ + noiseX,
            targetVelocityY,
            lookVector.Z * targetVelocityZ + noiseZ
        )
        linearVelocity.VectorVelocity = finalVelocity
        
        local targetTilt = -sinPhase * 55 
        weld.C0 = CFrame.new(0, -1, 0) * CFrame.Angles(math.rad(targetTilt), 0, 0)
        
        if cosPhase > 0.90 and not hitCooldown then
            hitCooldown = true
            humanoid:TakeDamage(math.random(9, 15))
            rootPart.AssemblyLinearVelocity = Vector3.new(lookVector.X * 18, -55, lookVector.Z * 18)
            
            local sound = Instance.new("Sound", beatingBlock)
            sound.SoundId = "rbxassetid://138090914" 
            sound.Volume = 3
            sound:Play()
            Debris:AddItem(sound, 1)
            
            task.delay(0.25, function()
                hitCooldown = false
                currentReach = math.random(86, 106) / 10 
            end)
        end
    end)
end

inputConnection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if input.KeyCode == Enum.KeyCode.H then
        startYetiAttack()
    end
end)

