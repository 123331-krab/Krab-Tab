local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Настройки подсветки игроков
local HIGHLIGHT_COLOR = Color3.fromRGB(255, 0, 0) -- Красный цвет
local FILL_TRANSPARENCY = 0.5 -- Прозрачность внутри
local OUTLINE_TRANSPARENCY = 0 -- Прозрачность границ

local espActive = false
local connections = {}

-- Функция удаления подсветки у конкретного игрока
local function removeHighlight(player)
    if player.Character then
        local hl = player.Character:FindFirstChild("Xeno_ESP_Highlight")
        if hl then hl:Destroy() end
    end
end

-- Функция добавления подсветки конкретному игроку
local function applyHighlight(player)
    if player == LocalPlayer then return end -- Себя не подсвечиваем

    local function setup(character)
        if not espActive then return end
        if not character or not character:IsDescendantOf(workspace) then return end
        
        -- Удаляем старую, если она вдруг осталась
        local oldHl = character:FindFirstChild("Xeno_ESP_Highlight")
        if oldHl then oldHl:Destroy() end

        -- Создаем новую подсветку
        local highlight = Instance.new("Highlight")
        highlight.Name = "Xeno_ESP_Highlight"
        highlight.FillColor = HIGHLIGHT_COLOR
        highlight.FillTransparency = FILL_TRANSPARENCY
        highlight.OutlineColor = HIGHLIGHT_COLOR
        highlight.OutlineTransparency = OUTLINE_TRANSPARENCY
        highlight.Adornee = character
        highlight.Parent = character
    end

    -- Вешаем подсветку на текущего персонажа
    if player.Character then
        setup(player.Character)
    end

    -- Следим за его респавном (если он умрет и возродится)
    local charConnection = player.CharacterAdded:Connect(function(char)
        task.wait(0.1) -- Небольшая задержка, чтобы персонаж успел прогрузиться
        setup(char)
    end)
    
    connections[player] = charConnection
end

-- Функция включения/выключения ESP для всех
local function toggleESP()
    espActive = not espActive

    if espActive then
        -- Включаем для всех текущих игроков
        for _, player in ipairs(Players:GetPlayers()) do
            applyHighlight(player)
        end
    else
        -- Выключаем и чистим
        for _, player in ipairs(Players:GetPlayers()) do
            removeHighlight(player)
        end
    end
end

-- Следим за новыми игроками, которые заходят на сервер
Players.PlayerAdded:Connect(function(player)
    if espActive then
        applyHighlight(player)
    end
end)

-- Убираем отслеживание, если игрок вышел из игры
Players.PlayerRemoving:Connect(function(player)
    if connections[player] then
        connections[player]:Disconnect()
        connections[player] = nil
    end
end)

-- Отслеживание нажатия кнопки L
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    if gameProcessedEvent then return end 

    if input.KeyCode == Enum.KeyCode.L then
        toggleESP()
    end
end)

