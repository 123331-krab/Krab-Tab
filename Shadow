local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local localPlayer = Players.LocalPlayer
local mouse = localPlayer:GetMouse()

local isMimicking = false
local isUnloaded = false
local targetPlayer = nil

local myStartPos = Vector3.zero
local targetStartPos = Vector3.zero
local loadedTracks = {}
local connections = {}
local function getPlayerFromTarget(target)
	if not target then return nil end
	local model = target:FindFirstAncestorOfClass("Model")
	if not model then return nil end
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= localPlayer and plr.Character == model then
			return plr
		end
	end
	return nil
end
local function clearLoadedTracks()
	for _, track in pairs(loadedTracks) do
		if track then
			pcall(function()
				track:Stop(0)
				track:Destroy()
			end)
		end
	end
	table.clear(loadedTracks)
end
local function stopMimic()
	isMimicking = false
	targetPlayer = nil
	clearLoadedTracks()

	local myChar = localPlayer.Character
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")
	if myHum then
		myHum.AutoRotate = true
	end

	local animateScript = myChar and myChar:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("LocalScript") then
		animateScript.Disabled = false
	end
end
local function startMimic(plr)
	local myChar = localPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

	local targetChar = plr and plr.Character
	local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")

	if not (myRoot and myHum and targetRoot) then return end

	stopMimic()

	targetPlayer = plr
	myStartPos = myRoot.Position
	targetStartPos = targetRoot.Position
	isMimicking = true
	myHum.AutoRotate = false

	local animateScript = myChar:FindFirstChild("Animate")
	if animateScript and animateScript:IsA("LocalScript") then
		animateScript.Disabled = true
	end

	local myAnimator = myHum:FindFirstChildOfClass("Animator")
	if myAnimator then
		for _, track in ipairs(myAnimator:GetPlayingAnimationTracks()) do
			track:Stop(0)
		end
	end
end
local function syncMovementAndRotation(myRoot, targetRoot)
	local offset = targetRoot.Position - targetStartPos
	local newPos = myStartPos + offset
	local targetRotation = targetRoot.CFrame - targetRoot.CFrame.Position

	myRoot.CFrame = CFrame.new(newPos) * targetRotation
	myRoot.AssemblyLinearVelocity = Vector3.zero
	myRoot.AssemblyAngularVelocity = Vector3.zero
end
local function syncAnimations(myHum, targetHum)
	local myAnimator = myHum:FindFirstChildOfClass("Animator")
	local targetAnimator = targetHum:FindFirstChildOfClass("Animator")
	if not (myAnimator and targetAnimator) then return end

	local activeIds = {}

	for _, tTrack in ipairs(targetAnimator:GetPlayingAnimationTracks()) do
		local animObj = tTrack.Animation
		if animObj and animObj.AnimationId ~= "" then
			local id = animObj.AnimationId
			activeIds[id] = true

			local mTrack = loadedTracks[id]
			if not mTrack then
				local ok, newTrack = pcall(function()
					return myAnimator:LoadAnimation(animObj)
				end)
				if ok and newTrack then
					newTrack.Priority = tTrack.Priority
					newTrack:Play(0, tTrack.WeightCurrent, tTrack.Speed)
					loadedTracks[id] = newTrack
					mTrack = newTrack
				end
			end

			if mTrack then
				if not mTrack.IsPlaying then
					mTrack:Play(0, tTrack.WeightCurrent, tTrack.Speed)
				end
				mTrack:AdjustSpeed(tTrack.Speed)
				mTrack:AdjustWeight(tTrack.WeightCurrent, 0)
				if math.abs(mTrack.TimePosition - tTrack.TimePosition) > 0.15 then
					mTrack.TimePosition = tTrack.TimePosition
				end
			end
		end
	end
	for id, mTrack in pairs(loadedTracks) do
		if not activeIds[id] then
			pcall(function()
				mTrack:Stop(0.1)
				mTrack:Destroy()
			end)
			loadedTracks[id] = nil
		end
	end
end
local function unloadScript()
	if isUnloaded then return end
	stopMimic()
	isUnloaded = true
	for _, conn in ipairs(connections) do
		if conn then
			conn:Disconnect()
		end
	end
	table.clear(connections)
end
table.insert(connections, RunService.RenderStepped:Connect(function()
	if isUnloaded or not isMimicking or not targetPlayer then return end

	if targetPlayer.Parent ~= Players then
		stopMimic()
		return
	end

	local myChar = localPlayer.Character
	local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
	local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

	local targetChar = targetPlayer.Character
	local targetRoot = targetChar and targetChar:FindFirstChild("HumanoidRootPart")
	local targetHum = targetChar and targetChar:FindFirstChildOfClass("Humanoid")

	if not (myRoot and myHum and targetRoot and targetHum) then return end

	syncMovementAndRotation(myRoot, targetRoot)
	syncAnimations(myHum, targetHum)
end))
table.insert(connections, localPlayer.CharacterAdded:Connect(function()
	if not isUnloaded and isMimicking then
		stopMimic()
	end
end))

_G.KrabHubScripts = _G.KrabHubScripts or {}

if _G.KrabHubScripts["Mimic"] then
	pcall(_G.KrabHubScripts["Mimic"])
end

_G.KrabHubScripts["Mimic"] = unloadScript
table.insert(connections, UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if isUnloaded then return end

	if input.KeyCode == Enum.KeyCode.RightAlt then
		unloadScript()
		return
	end
	if gameProcessed then return end

	if input.KeyCode == Enum.KeyCode.X then
		if isMimicking then
			stopMimic()
		else
			local hoveredPlayer = getPlayerFromTarget(mouse.Target)
			if hoveredPlayer then
				startMimic(hoveredPlayer)
			end
		end
	end
end))
